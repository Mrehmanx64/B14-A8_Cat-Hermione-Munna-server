# ---------------------------------------------------------------------------
# Shongkolpo API (Express) — copy to .env and fill in real values.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Same Atlas database the Next.js client connects to.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=shongkolpo

# Public URL of the Next.js app. Must match the `issuer` and `audience` it
# puts into its JWTs, or every token will fail verification.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Where the public keys live. Defaults to `${BETTER_AUTH_URL}/api/auth/jwks`.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Comma-separated list of origins allowed by CORS. In production this must be
# the exact Vercel URL, or the browser will block every API call.
CLIENT_URL=http://localhost:3000
